{
  "name": "soundscape",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "services:up": "docker compose -f infra/docker-compose.yml up -d postgres redis elasticsearch",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @soundscape/db exec dotenv -e ../../.env -- prisma migrate dev --name",
    "db:generate": "pnpm --filter @soundscape/db generate",
    "db:seed": "pnpm --filter @soundscape/db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "ioredis": "^5.3.2"
    }
  }
}

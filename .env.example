# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://soundscape:devpassword@localhost:5432/soundscape

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Elasticsearch ─────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── ML Service ────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
ENCRYPTION_KEY=change-me-in-production-32-bytes!!   # AES-256 key for OAuth token encryption

# ── Spotify ───────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback

# ── Apple Music (Phase 3) ─────────────────────────────────
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=   # PEM content of your .p8 key (ES256)

# ── Last.fm (Phase 3) ─────────────────────────────────────
LASTFM_API_KEY=
LASTFM_SECRET=
LASTFM_REDIRECT_URI=http://localhost:3000/auth/lastfm/callback

# ── YouTube Music (Phase 3) ───────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

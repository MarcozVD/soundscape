{
  "name": "@soundscape/db",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev --name",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@soundscape/config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}

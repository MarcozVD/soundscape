{
  "name": "@soundscape/api",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "workers": "ts-node src/workers/index.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.16.3",
    "@soundscape/auth": "workspace:*",
    "@soundscape/db": "workspace:*",
    "@soundscape/music-providers": "workspace:*",
    "@soundscape/types": "workspace:*",
    "@trpc/server": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@soundscape/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
